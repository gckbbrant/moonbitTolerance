      bias: -0.0020,
      repeatability: 0.0010,
      confidence: 0.92,
    },
    {
      instrument: "laser",
      axis: "y",
      nominal: 82.50,
      bias: -0.0015,
      repeatability: 0.0015,
      confidence: 0.93,
    },
    {
      instrument: "micrometer",
      axis: "z",
      nominal: 85.00,
      bias: -0.0010,
      repeatability: 0.0020,
      confidence: 0.94,
    },
    {
      instrument: "vision",
      axis: "diameter",
      nominal: 87.50,
      bias: -0.0005,
      repeatability: 0.0025,
      confidence: 0.95,
    },
  ]
}

///|
pub fn calibration_point_count() -> Int {
  calibration_points().length()
}

///|
pub fn corrected_measurement(
  point : CalibrationPoint,
  observed : Double,
) -> Double {
  observed - point.bias
}

///|
test "calibration corpus is usable" {
  let points = calibration_points()
  assert_eq(points.length(), 256)
  assert_eq(calibration_point_count(), 256)
  assert_eq(corrected_measurement(points[0], 12.0), 12.002)
}
