///|
test "reference corpus has stable engineering shape" {
  let vectors = reference_vectors()
  assert_eq(vectors.length(), 512)
  assert_eq(standard_profile_count(), 1024)
  assert_true(vectors[0].worst_lower <= vectors[0].nominal)
  assert_true(vectors[511].rss_sigma > 0.0)
}
